		{
			"name": "All_In_One",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const testIndex = pm.collectionVariables.get('testIndex');\r",
							"const iteration = parseInt(testIndex, 10);\r",
							"\r",
							"const emailGenerators = [\r",
							"    (rand) => rand + 'test.com',       \r",
							"    (rand) => rand + '@.com',          \r",
							"    () => '@test.com',                 \r",
							"    (rand) => rand + ' @test.com',     \r",
							"    (rand) => rand + '@test'           \r",
							"];\r",
							"\r",
							"const totalTests = emailGenerators.length; \r",
							"\r",
							"if (iteration < totalTests) {    \r",
							"    const randomNumber = Math.floor(Math.random() * 10000000);\r",
							"    const emailToTest = emailGenerators[iteration](randomNumber.toString()); \r",
							"    pm.collectionVariables.set('email', emailToTest);\r",
							"    \r",
							"} else {\r",
							"    console.log(\"Тест завершен. Да вгомонись ти вже ))))\");\r",
							"}\r",
							"\r",
							"\r",
							"const currentBaseUrl = pm.iterationData.get('base_url_value'); \r",
							"pm.environment.set('baseUrl', currentBaseUrl);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Email format is invalid\", function () {\r",
							"    pm.response.to.have.status(400);\r",
							"    pm.expect(pm.response.json().message).to.include(\"Email is incorrect\");\r",
							"});\r",
							"\r",
							"const totalTests = 5; \r",
							"let currentTestIndex = parseInt(pm.collectionVariables.get('testIndex'), 10); \r",
							"let nextTestIndex = currentTestIndex + 1;\r",
							"\r",
							"if (nextTestIndex < totalTests) {\r",
							"    pm.collectionVariables.set('testIndex', nextTestIndex);\r",
							"    postman.setNextRequest(pm.info.requestName);\r",
							"    \r",
							"} else {\r",
							"    postman.setNextRequest(null);\r",
							"    pm.collectionVariables.set('testIndex', 0); \r",
							"    console.log(\"Все ВелДоне.\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
