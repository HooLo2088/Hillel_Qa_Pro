			"name": "EditUserProfile",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const photo = 'user-' + Math.random(13) * 100000000000000000 + '.jpg'\r",
							"\r",
							"const name = pm.variables.replaceIn('{{$randomFirstName}}');\r",
							"\r",
							"pm.collectionVariables.set('name', name);\r",
							"pm.collectionVariables.set('photo', photo)\r",
							"\r",
							"const currentBaseUrl = pm.iterationData.get('base_url_value'); \r",
							"pm.environment.set('baseUrl', currentBaseUrl);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const requestBody = {\r",
							"    photo: pm.request.body.raw.photo,\r",
							"    name: pm.request.body.raw.name,\r",
							"    lastName: pm.request.body.raw.lastName,\r",
							"    dateBirth: pm.request.body.raw.dateBirth,\r",
							"    country: pm.request.body.raw.country\r",
							"};\r",
							"\r",
							"const responseJson = pm.response.json();\r",
							"\r",
							"pm.test(\"Response matches the request body\", function () {\r",
							"    pm.expect(responseJson.photo).to.eql(requestBody.photo);\r",
							"    pm.expect(responseJson.name).to.eql(requestBody.name);\r",
							"    pm.expect(responseJson.lastName).to.eql(requestBody.lastName);\r",
							"    pm.expect(responseJson.country).to.eql(requestBody.country);\r",
							"});\r",
							"\r",
							"pm.test(\"Date of birth is correct\", function () {\r",
							"    const responseDate = new Date(responseJson.dateBirth);\r",
							"    const requestDate = new Date(requestBody.dateBirth);\r",
							" \r",
							"    pm.expect(responseDate.getFullYear()).to.eql(requestDate.getFullYear());\r",
							"    pm.expect(responseDate.getMonth()).to.eql(requestDate.getMonth());\r",
							"    pm.expect(responseDate.getDate()).to.eql(requestDate.getDate());\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
