		{
			"name": "CreateUser Copy",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const timestamp = Date.now();\r",
							"const randomPart = Math.floor(Math.random() * 1000);\r",
							"const email = `test-user-${timestamp}-${randomPart}@gmail.com`;\r",
							"\r",
							"pm.collectionVariables.set('email', email);\r",
							"\r",
							"const currentBaseUrl = pm.iterationData.get('base_url_value'); \r",
							"pm.environment.set('baseUrl', currentBaseUrl);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// --- Настройка для валидации схемы (используем ajv вместо tv4) ---\r",
							"const Ajv = require('ajv');\r",
							"const ajv = new Ajv({ logger: console, allErrors: true });\r",
							"\r",
							"// --- 1. Схема успешного ответа (201 Created) ---\r",
							"const successSchema = {\r",
							"    \"type\": \"object\",\r",
							"    \"properties\": {\r",
							"        \"status\": { \"type\": \"string\" },\r",
							"        \"data\": {\r",
							"            \"type\": \"object\",\r",
							"            \"properties\": {\r",
							"                \"userId\": { \"type\": \"number\" },\r",
							"                \"photoFilename\": { \"type\": \"string\" },\r",
							"                \"distanceUnits\": { \"type\": \"string\" },\r",
							"                \"currency\": { \"type\": \"string\" }\r",
							"            },\r",
							"            \"required\": [\"userId\", \"photoFilename\", \"distanceUnits\", \"currency\"]\r",
							"        }\r",
							"    },\r",
							"    \"required\": [\"status\", \"data\"]\r",
							"};\r",
							"\r",
							"// --- 2. Условное выполнение скриптов ---\r",
							"\r",
							"// Если запрос завершился успехом (ожидаем 201 Created для регистрации)\r",
							"if (pm.response.code === 201) {\r",
							"\r",
							"    const responseJson = pm.response.json();\r",
							"    \r",
							"    // A. Тест: Проверка статус-кода\r",
							"    pm.test(\"Status code is 201 Created\", function () {\r",
							"        pm.response.to.have.status(201);\r",
							"    });\r",
							"\r",
							"    // B. Тест: Валидация схемы (только при успехе)\r",
							"    pm.test('Schema is valid (AJV)', function () {\r",
							"        const validate = ajv.compile(successSchema);\r",
							"        const isValid = validate(responseJson);\r",
							"\r",
							"        if (!isValid) {\r",
							"            console.error(\"Schema validation failed:\", validate.errors);\r",
							"        }\r",
							"        pm.expect(isValid).to.be.true;\r",
							"    });\r",
							"\r",
							"    // C. Сохранение переменных (только при успехе)\r",
							"    if (responseJson.data && responseJson.data.userId) {\r",
							"        pm.collectionVariables.set(\"userId\", responseJson.data.userId);\r",
							"        \r",
							"        // !!! ДОБАВЬТЕ ЭТО, ЕСЛИ API ВЫДАЕТ ТОКЕН ПРИ РЕГИСТРАЦИИ (редко)\r",
							"        // pm.collectionVariables.set(\"authToken\", responseJson.data.token);\r",
							"    }\r",
							"\r",
							"} \r",
							"// Если запрос завершился с ошибкой (например, 400 Bad Request)\r",
							"else if (pm.response.code === 400) {\r",
							"    \r",
							"    // Тест: Проверка статус-кода ошибки\r",
							"    pm.test(\"Status code is 400 Bad Request\", function () {\r",
							"        pm.response.to.have.status(400);\r",
							"    });\r",
							"\r",
							"    // Тест: Проверка сообщения об ошибке\r",
							"    try {\r",
							"        const responseJson = pm.response.json();\r",
							"        pm.test(\"Error message indicates duplicate/invalid data\", function () {\r",
							"            // Замените эту строку на реальное сообщение об ошибке, которое вы получаете\r",
							"            pm.expect(JSON.stringify(responseJson)).to.include(\"Email already exists\"); \r",
							"        });\r",
							"    } catch (e) {\r",
							"        pm.test(\"Response is valid JSON error object\", function() {\r",
							"            throw new Error(\"Failed to parse JSON for 400 response.\");\r",
							"        });\r",
							"    }\r",
							"\r",
							"} else {\r",
							"    // Тест: Неожиданный статус-код\r",
							"    pm.test(`Unexpected Status Code: ${pm.response.code}`, function () {\r",
							"        pm.expect(pm.response.code).to.be.oneOf([201, 400]);\r",
							"    });\r",
							"}\r",
							"\r",
							"// --- 3. Тесты, независимые от ответа (например, проверка данных запроса) ---\r",
							"\r",
							"// Этот тест проверяет, что данные, которые вы ОТПРАВИЛИ, были корректны.\r",
							"pm.test(\"Request email format is valid (from request body)\", function () {\r",
							"    const requestBody = JSON.parse(pm.request.body.raw);\r",
							"    const requestEmail = requestBody.email;\r",
							"    const emailPattern = /^[a-zA-Z0-9]+(\\.[a-zA-Z0-9]+)*@(gmail\\.com)$/;\r",
							"\r",
							"    pm.expect(requestEmail).to.match(emailPattern);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
